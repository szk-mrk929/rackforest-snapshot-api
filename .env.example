# General configuration
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT=24

# HTTP server configuration
HTTP_ADDR=:3000

# Worker configuration
WORKER_COUNT=3
WORKER_ATTEMPTS=3
WORKER_QUEUE_SIZE=128

# Non-deleted snapshots per tenant
TENANT_SNAPSHOT_QUOTA=10

# One storage call. A bare number is seconds.
STORAGE_TIMEOUT=30

# Exponential backoff base: 200ms, then 400ms.
RETRY_BASE_DELAY=200ms

# Random mock delay. A bare number is seconds.
STORAGE_MIN_DELAY=2
STORAGE_MAX_DELAY=10

# Random mock failure probability, from 0 to 1.
STORAGE_ERROR_RATE=0.2

# memory (default) or postgres. Postgres needs DATABASE_URL.
STORE_DRIVER=memory
# DATABASE_URL=postgres://snapshot:snapshot@127.0.0.1:5432/snapshot?sslmode=disable
